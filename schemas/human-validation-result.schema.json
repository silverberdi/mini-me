{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_head_sha",
    "base_sha",
    "scenarios",
    "decision"
  ],
  "properties": {
    "candidate_head_sha": {
      "type": "string"
    },
    "base_sha": {
      "type": "string"
    },
    "image_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "enum": [
        "approve",
        "request_changes",
        "reject"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
