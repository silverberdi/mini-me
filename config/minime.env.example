# Copy values to a protected host file such as /etc/minime/minime.env.
# Never commit the real file.
MINIME_DATABASE_URL=postgresql+psycopg://minime:CHANGE_ME@127.0.0.1:5432/minime
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MINIME_GITHUB_APP_ID=
MINIME_GITHUB_INSTALLATION_ID=
MINIME_GITHUB_PRIVATE_KEY_PATH=/etc/minime/secrets/github-app.pem
