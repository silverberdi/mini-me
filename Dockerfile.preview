FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN addgroup --system minime \
    && adduser --system --ingroup minime --home /nonexistent minime

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --no-cache-dir .

USER minime
EXPOSE 8787

CMD ["uvicorn", "minime.api.app:app", "--host", "0.0.0.0", "--port", "8787"]
